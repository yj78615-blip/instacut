# 생성물 — 다시 돌리면 재생성된다
projects/*/raw/
projects/*/out/
outputs/
# blueprint 는 render.py 가 매번 생성한다 (소스가 아니라 산출물)
blueprints/

# 캐릭터 레퍼런스(character_ref.png)는 커밋한다 — 팀이 같은 캐릭터로 작업해야 하고,
# 이게 없으면 컷마다 다른 인물이 나온다. 크기도 작다(수 KB).

# 비밀 — API 키는 절대 커밋하지 않는다
.env
*.key
secrets.*

# 파이썬
.venv/
__pycache__/
*.pyc

# comfy 실행 상태
.comfy/
