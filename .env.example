# 이 파일을 .env 로 복사해서 값을 채우세요.
#   copy .env.example .env
#
# .env 는 .gitignore 에 있어 커밋되지 않습니다. 키를 코드나 project.json 에 넣지 마세요.


# Gemini(Nano Banana) 백엔드를 쓸 때만 필요합니다.
#   uv run python -m instacut.cli render --backend gemini
#
# 없으면 로컬 ComfyUI 로만 동작합니다 (기본값). 인물 위치 검출도 얼굴 검출로 내려갑니다.
#
# 발급: https://aistudio.google.com/apikey
# 주의: 이미지 생성은 무료 티어에서 막혀 있습니다. 결제를 활성화해야 합니다.
#       (활성화 전에는 429 "limit: 0" 이 납니다)
GOOGLE_API_KEY=


# --- 셸에서 읽는 법 ---
#
# PowerShell:
#   Get-Content .env | Where-Object { $_ -match '^\w+=' } | ForEach-Object {
#     $k, $v = $_ -split '=', 2
#     if ($v) { Set-Item "env:$k" $v }
#   }
#
# bash:
#   set -a; source .env; set +a
#
# 한 번만 쓸 거라면 그냥 환경변수로 넘겨도 됩니다.
#   PowerShell:  $env:GOOGLE_API_KEY = "..."
